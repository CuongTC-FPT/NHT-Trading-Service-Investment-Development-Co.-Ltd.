PORT=3000
NODE_ENV=production

# SMTP (Gmail: dung App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

ADMIN_EMAIL=ban@congty.com

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-manh
ADMIN_SESSION_SECRET=doi-thanh-chuoi-bi-mat-dai
# Render chay HTTPS qua reverse proxy, cookie admin phai secure.
COOKIE_SECURE=true

# Neon: uu tien DATABASE_URL, lay tu Neon dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
DB_SSL=true

# PostgreSQL local (chi dung khi khong co DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=NHT_db
DB_USER=postgres
DB_PASSWORD=replace_with_your_postgres_password

# Cloudinary (server-side only)
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
